# Configuration for train_cluster.sh. Copy to .env and fill in; .env is gitignored.
# Use single quotes for values containing '$' (e.g. Harbor robot accounts: 'robot$name').

# ---------------------------------------------------------------- Kubernetes
KUBE_CONTEXT=                 # kubectl context of the cluster
K8S_NAMESPACE=                # namespace to run in
POD_LABELS=                   # comma-separated key=value pod labels (e.g. storage mount / batch quota labels)
KUEUE_QUEUE=                  # Kueue LocalQueue for GPU jobs
GPU_PRODUCT=                  # value of the nvidia.com/gpu.product node label (e.g. NVIDIA-H200); check the
                              # real values with: kubectl get nodes -L nvidia.com/gpu.product
TOLERATIONS=nvidia.com/gpu    # comma-separated taint keys to tolerate (operator Exists, effect NoSchedule)
NUM_GPUS=8
CPU_PER_GPU=12
MEM_PER_GPU_GI=100
SHM_SIZE_GI=64

# ---------------------------------------------------------------- Container registry
REGISTRY=                     # registry host
REGISTRY_PROJECT=             # project/namespace in the registry
IMAGE_NAME=unite-ota
BASE_IMAGE=pytorch/pytorch:2.10.0-cuda12.8-cudnn9-runtime
BUILDKIT_ADDR=                # build remote: BuildKit server address, e.g. tcp://<host>:1234
BUILDKIT_IMAGE=moby/buildkit:rootless   # build remote: image providing buildctl for the build client pod
BUILDKIT_CERTS_SECRET=        # build remote: secret with the BuildKit client TLS certificates
IMAGE_PULL_SECRET=            # existing pull secret in the namespace (optional for public projects)
REGISTRY_USER=                # docker login user; required (push-enabled) for 'build remote'
REGISTRY_PASSWORD=            # docker login password / CLI secret / robot token

# ---------------------------------------------------------------- Storage (paths inside the pods)
DATA_PATH=                    # ImageFolder train dir, must end in /train (val is expected at ../val)
INCEPTION_WEIGHTS=            # Inception .pth for FID (downloaded if missing)
IN256_FID_STATS=              # ImageNet-256 FID reference stats .npz (downloaded if missing)
RESULTS_DIR=                  # checkpoints and logs

# ---------------------------------------------------------------- Dataset preparation (only if DATA_PATH is missing)
HF_TOKEN_SECRET=              # secret in the namespace holding key HF_TOKEN (needs access to timm/imagenet-1k-wds)
SUBSET_FRACTION=0.1           # fraction of the 1024 shuffled ImageNet train shards to download
VAL_SHARDS=8                  # validation shards to download (64 total, ~780 images each)

# ---------------------------------------------------------------- Training
JOB_NAME=unite-ota
EXPERIMENT_NAME=lets-unite-subset
CONFIG=configs/imagenet.yaml
TOTAL_BATCH_SIZE=1024
PER_GPU_BATCH=64              # gradient accumulation = TOTAL_BATCH_SIZE / (NUM_GPUS * PER_GPU_BATCH)
EPOCHS=                       # empty = value from CONFIG
RESUME_CKPT=                  # empty = resume from the latest checkpoint of EXPERIMENT_NAME, if any
WANDB_API_KEY=                # optional: empty = wandb offline mode (logs stored under RESULTS_DIR)
